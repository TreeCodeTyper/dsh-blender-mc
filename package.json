{
  "name": "dsh-blender-mc",
  "version": "0.3.3",
  "description": "Minecraft 存档 → Blender 封面 / 动画。自动找机位、导出几何、搭场景、渲染，并用 OpenCV 自动审图（渲完自己检查朝向 / 接地 / 曝光 / 布光 / 构图，不合格自动调参重渲）。自带模型能力：把你自己资源包里的 Bedrock 模型转成 OBJ 摆进画面（插件不附带任何模型/贴图）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TreeCodeTyper/dsh-blender-mc.git"
  },
  "homepage": "https://github.com/TreeCodeTyper/dsh-blender-mc#readme",
  "bugs": {
    "url": "https://github.com/TreeCodeTyper/dsh-blender-mc/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "py/**/*.py",
    "docs/*.md",
    "scripts/*.py",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "icon.svg",
    "locale"
  ],
  "keywords": [
    "dsh-plugin",
    "minecraft",
    "blender",
    "opencv",
    "computer-vision",
    "animation",
    "render",
    "anvil",
    "mcprep",
    "bedrock",
    "obj",
    "model",
    "3d"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "scripts": {
    "doctor": "python py/cli.py doctor",
    "setup": "python py/cli.py setup",
    "check": "python py/cli.py check",
    "smoke": "node scripts/smoke.mjs",
    "install-profile": "python scripts/install_to_profile.py",
    "repair-profile": "python scripts/repair_profile.py"
  }
}
